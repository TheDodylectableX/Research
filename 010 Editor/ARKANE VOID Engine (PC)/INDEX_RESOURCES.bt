// Output the right .resources besides the archive number
string ReadArchiveListing(ushort &ID) {
    string S;
    string Name = GetArchiveName(ID);
    if (Name != "")  { SPrintf(S, "%d: %s", ID, Name); }
    else { SPrintf(S, "%d: Unknown .resources Archive", ID); }
    return S;
}

//-----------------------------------------------------------------------------------------------

typedef struct {
    BigEndian();
    INDEX_TYPE INDEXType <name="INDEX Type", comment="4: Index | 5: Resources">;
    char       Magic[3]  <name="Magic",      comment="Always SER">;
    uint       INDEXSize <name="INDEX Size", comment="Size of this file minus 32 bytes">;
    FSkip(24); // Reserved
    uint       fileCount <name="File Count">;
} INDEX_HEADER <read=Str("INDEX Type: %d | INDEX Magic: %s | INDEX Size: %u bytes | File Count: %u Files", this.INDEXType, this.Magic, this.INDEXSize + 32, this.fileCount)>;

typedef struct {
    LittleEndian();
    uint   resourceIndex            <name="Resource Index">;
    String resourceType             <name="Resource Type">;
    String resourceListingUncooked  <name="Resource Listing (Uncooked)",  comment="Uncooked file listing, Referenced in DECLs and the files themselves">;
    String resourceListingCooked    <name="Resource Listing (Cooked)",    comment="Cooked file listing, the file's actual path">;
    uint64 resourceOffset           <name="Resource Offset",              comment="Absolute">;
    uint   resourceSizeUncompressed <name="Resource Size (Uncompressed)">;
    uint   resourceSizeCompressed   <name="Resource Size (Compressed)",   comment="Oodle (Kraken)">;
    FSkip(12); // Reserved
    ushort archiveIndex <read=ReadArchiveListing, name="Archive Number",  comment="The number of the archive this file is stored in, Corresponds to master.index' archive ordering">;
} INDEX_ENTRY <name="File Entry", read=Str("ID: %u | %s | %s | File Offset: %u | File Size (Uncompressed): %u bytes",
                                           this.resourceIndex, this.resourceType.ActualString, this.resourceListingCooked.ActualString, this.resourceOffset, this.resourceSizeUncompressed)>;

//-----------------------------------------------------------------------------------------------

struct {
    INDEX_HEADER Header;
    if (Header.fileCount > 0) INDEX_ENTRY Entry[Header.fileCount] <comment="INDEX File Listing", optimize=false>;
} INDEX_VOID <name="Arkane Studios VOID Engine master_resources.index File">;

//-----------------------------------------------------------------------------------------------
