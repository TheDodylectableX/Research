// .resources Archives are compressed with Oodle (Kraken)
// Archive Number corresponds to the order of archives in the "master.index" file

#include "../Common.bt"

typedef enum <ubyte> {
    INDEX     = 4,
    RESOURCES = 5
} INDEX_TYPE;

// List of all archives part of the latest update
