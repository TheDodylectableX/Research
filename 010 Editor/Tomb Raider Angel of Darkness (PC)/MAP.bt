//------------------------------------------------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: MAP.bt
//   Authors: Dodylectable
//   Version: 1.0
//   Purpose: Reverse engineering Tomb Raider: Angel of Darkness Remastered's texture lists
//  Category: File Lists
// File Mask: *.MAP
//  ID Bytes: 
//   History: 
//------------------------------------------------------------------------------------------

// The textures are inside the TEX folder.
// Each entry is 16 bytes long but most textures are 15 characters long only.

//------------------------------------------------------------------------------------------

typedef struct { uint textureCount    <name="Texture Count">; } MAP_HEADER <read=Str("%u Textures", this.textureCount)>;
typedef struct { char textureName[16] <name="Texture Name">;  } MAP_ENTRY  <read=Str("%s.DDS",      this.textureName)>;

//------------------------------------------------------------------------------------------

struct {
    MAP_HEADER Header;
    if (Header.textureCount > 0) MAP_ENTRY Texture[Header.textureCount] <optimize=false>;
} MAP <name="Tomb Raider: Angel of Darkness Remastered .MAP Texture List">;

//------------------------------------------------------------------------------------------
