//--------------------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: CMESH_XBOX2.bt
//   Authors: Dodylectable
//   Version: 1.0
//   Purpose: Reverse engineering Saints Row's character models
//  Category: Models
// File Mask: *.cmesh_xbox2
//  ID Bytes: 42 4B D0 0D
//   History: 
//--------------------------------------------------------------

BigEndian();
#include "../Common.bt"

local int   lodCount               <hidden=true> = 0;
local int64 lodDescriptorOffset[8] <hidden=true>;
local int64 lodSubMeshOffset[8]    <hidden=true>;
local int64 lodFaceOffset[8]       <hidden=true>;
local int64 lodVertexOffset[8]     <hidden=true>;
local int   lodVertexCount[8]      <hidden=true>;
local int   lodFaceCount[8]        <hidden=true>;
local int   lodVertexStride[8]     <hidden=true>;
local int   lodSubMeshCount[8]     <hidden=true>;
local int   currentLOD             <hidden=true>;

//--------------------------------------------------------------

typedef struct {
    VEC3F Positions;
    VEC4UB Weights, Indices;
    VEC4SB Normals, Tangents;
    VEC2SS UV1, UV2;
    if (lodVertexStride[currentLOD] == 40) VEC2US UV3;
    if (lodVertexStride[currentLOD] == 44) VEC2US UV3, UV4;
} Vertex;

typedef struct {
    uint   faceOffset    <name="Face Offset",    comment="Relative Offset from the LOD's face buffer start">;
    ushort faceCount     <name="Face Count",     comment="Tristrip face count">;
    ushort materialIndex <name="Material Index", comment="Index into the material string table">;
} Descriptor_Face <read=Str("Face Offset: %u | Face Count: %u | Material Index: %u", this.faceOffset, this.faceCount, this.materialIndex)>;

typedef struct {
    uint   Unknown <format=hex>;
    uint   runtimeHeapPointer_VertexBuffer <name="X360 Runtime Heap Pointer (Vertex Buffer)", format=hex>;
    uint   runtimeHeapPointer_FaceBuffer   <name="X360 Runtime Heap Pointer (Face Buffer)",   format=hex>;
    ushort vertexCount                     <name="Vertex Count">;
    ushort faceCount                       <name="Face Count">;
    ushort vertexStride                    <name="Vertex Stride">;
    ushort UVCount                         <name="UV Set Count">;
    ushort positionComponentCount          <name="Vertex Positions Component Count", comment="3: X, Y and Z duh">;
    FSkip(74); // Reserved
    uint   runtimeHeapPointer1             <name="X360 Runtime Heap Pointer 1", format=hex>;
    ushort embeddedStripBytes              <name="Embedded Strip Bytes">;
    ushort meshCount_Primary               <name="Mesh Count (Primary)">;
    FSkip(8); // Reserved
    uint   runtimeHeapPointer2             <name="X360 Runtime Heap Pointer 2", format=hex>;
    uint   runtimeHeapPointer3             <name="X360 Runtime Heap Pointer 3", format=hex>;
    ushort meshCount_Secondary             <name="Mesh Count (Secondary)">;
} Descriptor_Mesh <read=Str("Vertices: %u | Faces: %u | Stride: %u | UV Sets: %u", this.vertexCount, this.faceCount, this.vertexStride, this.UVCount)>;

typedef struct {
    local int subMeshCount <hidden=true> = lodSubMeshCount[currentLOD];
    local int vertexCount  <hidden=true> = lodVertexCount[currentLOD];
    local int faceCount    <hidden=true> = lodFaceCount[currentLOD];

    FSeek(lodSubMeshOffset[currentLOD]);
    Descriptor_Face Submeshes[lodSubMeshCount[currentLOD]] <optimize=false>;

    FSeek(lodDescriptorOffset[currentLOD]);
    Descriptor_Mesh MeshDescriptor <name="Mesh Descriptor">;

    FSeek(lodFaceOffset[currentLOD]);
    ushort Faces[lodFaceCount[currentLOD]] <comment="Tristrips, No 0xFFFF restart">;

    FSeek(lodVertexOffset[currentLOD]);
    Vertex Vertices[lodVertexCount[currentLOD]] <optimize=false>;
} LOD <name="LOD", read=Str("%u Meshes | %u Vertices | %u Faces", this.subMeshCount, this.vertexCount, this.faceCount)>;

//--------------------------------------------------------------

typedef struct {
    char   Magic[4];
    ushort Version;
    FSkip(6);  // Reserved
    ushort materialCount <name="Material Count">;
    FSkip(6);  // Reserved
    VEC4F  BoundingBox   <name="Bounding Box", comment="XYZ: Sphere | W: Radius">;
    ushort runtimeHeapPointerTableOffset <name="X360 Runtime Heap Pointer Table Offset">;
    FSkip(8);  // Reserved
    ushort Unknown <format=hex>;
    FSkip(16); // Reserved
} CMESH_HEADER <read=Str("%sVersion %u | %u Materials", this.Magic, this.Version, this.materialCount)>;

typedef struct {
    ushort meshCount <name="Mesh Count", comment="Plus one">;
    ushort Unknown   <format=hex>;
    FSkip(12); // Reserved
} Model_Subheader <read=Str("Mesh Count (+1): %u", this.meshCount)>;

//--------------------------------------------------------------
// LOD RESOLVER
// Function to keep the offset math out of the layout for tidiness
// and readability reasons Scans for every mesh descriptor by its
// signature then derives the per-LOD vertex/face/submesh layout
// and fills the global arrays.
//
//   Layout rules:
//     - Descriptor signature at D+0x10: [00 stride 00 uvCount 00 03 00 00]
//       where stride = 28 + uvCount*4 (uvCount 3 -> 40, 4 -> 44).
//     - Submesh table sits just before D; Its true length is found by
//       chaining 8-byte rows backward until the cumulative
//       (faceOffset + faceCount) equals the descriptor's faceCount and
//       the first row's offset is 0. (D+0x66 is only valid for LOD0.)
//     - LOD0 face buffer = First 0x1000 page after the runtime section
//       holding a valid index run >= faceCount entries.
//     - LOD(n>0) face buffer = align32(previous LOD vertex end).
//     - Vertex buffer = align32(face buffer + faceCount*2).
//--------------------------------------------------------------

void ResolveLODs(int64 scanStart) {
    local int   uvCount, stride;
    local int64 sigOffset, descriptor;
    local int   vCount, fCount, vStride, embBytes;
    local int64 rowEnd, row;
    local int   rowCount, rowBase, rowFaceCount, rowMaterial, chainEnd, chainFirstBase;
    local int64 tableOffset;

    //--- 1. Find every descriptor (LOD) by signature in file order
    for (uvCount = 3; uvCount <= 4; uvCount++) {
        stride = 28 + uvCount * 4;
        for (sigOffset = scanStart; sigOffset < FileSize() - 8; sigOffset++) {
            if (ReadByte(sigOffset)     == 0x00 && ReadByte(sigOffset + 1) == stride  &&
                ReadByte(sigOffset + 2) == 0x00 && ReadByte(sigOffset + 3) == uvCount &&
                ReadByte(sigOffset + 4) == 0x00 && ReadByte(sigOffset + 5) == 0x03    &&
                ReadByte(sigOffset + 6) == 0x00 && ReadByte(sigOffset + 7) == 0x00) {

                descriptor = sigOffset - 0x10;
                vCount     = ReadUShort(descriptor + 0x0C);
                fCount     = ReadUShort(descriptor + 0x0E);
                vStride    = ReadUShort(descriptor + 0x10);
                embBytes   = ReadUShort(descriptor + 0x64);
                if (vCount <= 0 || fCount <= 0 || lodCount >= 8) continue;

                //--- 2. True submesh table: Chain 8-byte rows backward
                tableOffset  = descriptor - 8; // Fallback (single row)
                rowCount     = 0;
                for (rowEnd  = descriptor; rowEnd >= descriptor - 8; rowEnd -= 8) {
                    rowCount = 0; row = rowEnd - 8;
                    chainEnd = -1; chainFirstBase = -1;
                    while (row >= 0 && rowCount < 64) {
                        rowBase      = ReadUInt(row);
                        rowFaceCount = ReadUShort(row + 4);
                        rowMaterial  = ReadUShort(row + 6);
                        if (rowBase < fCount && rowFaceCount > 0 && rowFaceCount <= fCount &&
                            rowMaterial < 256 && (rowBase + rowFaceCount) <= fCount) {
                            if (chainEnd == -1) chainEnd = rowBase + rowFaceCount;
                            chainFirstBase = rowBase;
                            rowCount++; row -= 8;
                        } else { break; }
                    }
                    if (rowCount > 0 && chainEnd == fCount && chainFirstBase == 0) {
                        tableOffset = row + 8; // Row overshot by one
                        break;
                    }
                }
                if (rowCount == 0) {
                    rowCount = ReadUShort(descriptor + 0x66);
                    if (rowCount == 0) rowCount = ReadUShort(descriptor + 0x78);
                    tableOffset = descriptor - rowCount * 8;
                }

                lodDescriptorOffset[lodCount] = descriptor;
                lodSubMeshOffset[lodCount]    = tableOffset;
                lodVertexCount[lodCount]      = vCount;
                lodFaceCount[lodCount]        = fCount;
                lodVertexStride[lodCount]     = vStride;
                lodSubMeshCount[lodCount]     = rowCount;
                // Embedded strip end (Runtime section end marker for this LOD)
                lodFaceOffset[lodCount]       = descriptor + 0x7A + embBytes; // temp: EMB end
                lodCount++;
            }
        }
    }
    if (lodCount == 0) return;

    //--- 3. Locate LOD0 face buffer: First 0x1000 page after the runtime section with a valid index run >= LOD0 face count
    local int64 runtimeEnd = lodFaceOffset[lodCount - 1]; // last EMB-strip end
    local int64 page = (runtimeEnd + 0xFFF) & ~0xFFF;
    local int64 cursor; local int run;
    local int64 face0 = 0;
    while (page < FileSize() - 4) {
        if (ReadUShort(page) == 0 &&
            ReadUShort(page + 2) < lodVertexCount[0] &&
            ReadUShort(page + 4) < lodVertexCount[0]) {
            run = 0; cursor = page;
            while (cursor < FileSize() - 2 && ReadUShort(cursor) < lodVertexCount[0]) { run++; cursor += 2; }
            if (run >= lodFaceCount[0]) { face0 = page; break; }
        }
        page += 0x1000;
    }

    //--- 4. Chain face/vertex buffers sequentially
    local int   i;
    local int64 facePos = face0;
    local int64 vertPos, vertEnd;
    for (i = 0; i < lodCount; i++) {
        vertPos = (facePos + lodFaceCount[i] * 2 + 0x1F) & ~0x1F;
        vertEnd = vertPos + lodVertexCount[i] * lodVertexStride[i];
        lodFaceOffset[i]   = facePos;
        lodVertexOffset[i] = vertPos;
        facePos = (vertEnd + 0x1F) & ~0x1F;
    }
}

//--------------------------------------------------------------

struct {
    CMESH_HEADER Header;

    FSeek(Header.runtimeHeapPointerTableOffset);
    uint materialPointerTable[Header.materialCount] <name="Material Runtime Heap Pointer Table", comment="Not file offsets", format=hex>;

    //--- Material/Texture name string table
    local int64 cursor <hidden=true> = Header.runtimeHeapPointerTableOffset + Header.materialCount * 4;
    while (cursor < FileSize() && ReadByte(cursor) == 0) cursor++;
    local int64 stringTableStart <hidden=true> = cursor;
    local int   nameIndex <hidden=true>;
    for (nameIndex = 0; nameIndex < Header.materialCount; nameIndex++) {
        while (cursor < FileSize() && ReadByte(cursor) != 0) cursor++;
        cursor++; // Skip terminator
    }
    local int64 stringTableEnd <hidden=true> = cursor;
    FSeek(stringTableStart);
    byte stringTable[stringTableEnd - stringTableStart] <name="Material String Table", comment="Null-terminated texture/material names">;

    // --- Bone remapping table
    local int64 boneTableOffset <hidden=true> = (stringTableEnd + 0xF) & ~0xF;
    FSeek(boneTableOffset);
    uint boneRemapTable[64] <name="Bone Remapping Table", comment="Havok bone palette, Identity 0..63 (256 bytes)">;

    //--- Model subheader
    local int64 subHeaderOffset <hidden=true> = boneTableOffset + 256;
    FSeek(subHeaderOffset);
    Model_Subheader modelSubHeader <name="Model Subheader">;

    //--- Resolve all LOD offsets up front
    ResolveLODs(subHeaderOffset + 16);

    //--- Runtime heap blob (everything between subheader and LOD0 faces)
    if (lodCount > 0 && lodFaceOffset[0] > subHeaderOffset + 16) {
        FSeek(subHeaderOffset + 16);
        byte runtimeSection[lodFaceOffset[0] - (subHeaderOffset + 16)] <name="Runtime Data", comment="Opaque heap: linked-list nodes, submesh tables, descriptors, embedded strips">;
    }

    //--- Emit each LOD (nested: submeshes + descriptor + faces + vertices)
    for (currentLOD = 0; currentLOD < lodCount; currentLOD++) LOD lods;
} CMESH <name="Volition Saints Row .CMESH_XBOX2 Character Model">;

//--------------------------------------------------------------