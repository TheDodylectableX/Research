//------------------------------------------------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: INDEX_RESOURCES.bt
//   Authors: Dodylectable, tjoener
//   Version: 1.0
//   Purpose: Reverse engineering Wolfenstein: The New Order / Old Blood's file list format
//  Category: Archives
// File Mask: *.index
//  ID Bytes: 03 53 45 52
//   History: 
//------------------------------------------------------------------------------------------

#include "../Common.bt"

typedef enum <ubyte> {
    INDEX     = 2,
    RESOURCES = 3
} INDEX_TYPE;

typedef struct {
    char Language[16]     <name="Platform Stream Data Language">;
    uint streamDataOffset <name="Platform Stream Data Offset">;
    uint streamDataSize   <name="Platform Stream Data Size">;
} RESOURCES_PLATFORMSTREAMDATA;

//------------------------------------------------------------------------------------------

typedef struct {
    BigEndian();
    INDEX_TYPE INDEXType  <name="INDEX Type", comment="2: Index | 3: Resources">;
    char       Magic[3]   <comment="Always SER">;
    uint       INDEXSize  <name="INDEX Size", comment="Size of this file minus 32 bytes">;
    FSkip(24); // Reserved
} INDEX_HEADER <read=Str("INDEX Type: %d | INDEX Magic: %s | INDEX Size: %u bytes", this.INDEXType, this.Magic, this.INDEXSize + 32)>;

typedef struct {
    BigEndian();
    uint   resourceIndex              <name="Resource Index">;
    LittleEndian();
    String resourceType               <name="Resource Type">;
    String resourceFileNameUncooked   <name="Resource Name (Uncooked)", comment="Referenced in DECL files">;
    String resourceFileNameCooked     <name="Resource Name (Cooked)",   comment="This is in the actual archive">;
    BigEndian();
    uint   resourceOffset             <name="Resource Offset">;
    uint   resourceSizeUncompressed   <name="Resource Size (Uncompresed)">;
    uint   resourceSizeCompressed     <name="Resource Size (Compressed)", comment="ZLib">;
    uint   idPlatformStreamDataCount  <name="Platform Stream Data Count">;
    if    (idPlatformStreamDataCount > 0) RESOURCES_PLATFORMSTREAMDATA platformStreamData[idPlatformStreamDataCount] <name="Platform Stream Data", optimize=false>;
    uint   resourceUseBits            <name="Use Bits?">;
    ubyte  resourceUnknown            <name="Resource Unknown", format=hex>;
} RESOURCES_ENTRY <name="File Entry", read=Str("ID: %u | %s | %s | File Offset: %u | File Size (Uncompressed): %u bytes",
                                               this.resourceIndex, this.resourceType.ActualString, this.resourceFileNameCooked.ActualString, this.resourceOffset, this.resourceSizeUncompressed)>;

//------------------------------------------------------------------------------------------

struct {
    INDEX_HEADER Header;
    uint fileCount      <name="File Count">;
    uint totalFileCount <name="Total File Count">;
    if (totalFileCount > 0) RESOURCES_ENTRY Entry[totalFileCount] <optimize=false>;
} INDEX <name="id Software id Tech 5 .INDEX File">;

//------------------------------------------------------------------------------------------